{
  "name": "@safe-shape/compat",
  "version": "2.0.2",
  "description": "Contract snapshots and compatibility analysis for SafeShape.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.10"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@safe-shape/core": "2.0.2"
  },
  "scripts": {
    "build": "npm run build --workspace @safe-shape/core && tsc -p tsconfig.build.json",
    "typecheck": "npm run build --workspace @safe-shape/core && tsc --noEmit",
    "test": "npm run build --workspace @safe-shape/core && npm run build && tsc -p tsconfig.test.json && node --test .tmp/test/tests/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-ik/safe_shape.git",
    "directory": "packages/compat"
  },
  "homepage": "https://github.com/dev-ik/safe_shape#readme",
  "bugs": {
    "url": "https://github.com/dev-ik/safe_shape/issues"
  }
}
